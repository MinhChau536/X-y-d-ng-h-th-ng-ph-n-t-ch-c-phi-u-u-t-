# ==============================================================================
# STOCK ANALYTICS PRO - ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env: copy .env.example .env (hoặc cp .env.example .env)
# ==============================================================================

# 1. VNSTOCK API KEY (Nguồn dữ liệu thị trường chính)
# Lấy API Key miễn phí tại: https://vnstocks.com/account#api-key
# Nếu chưa có, bạn có thể ĐỂ TRỐNG (hệ thống sẽ chạy ở chế độ Community mặc định)
VNSTOCK_API_KEY=
VNSTOCK_SOURCE=VCI

# 2. DNSE API (Nguồn bổ trợ - Không bắt buộc)
# Nếu không có tài khoản chứng khoán tại DNSE, hãy ĐỂ TRỐNG:
DNSE_BASE_URL=https://api.dnse.com.vn
DNSE_USERNAME=
DNSE_PASSWORD=
DNSE_TOKEN=

# 3. MÔI TRƯỜNG & LOGGING
APP_ENV=development
LOG_LEVEL=INFO

# 4. THỜI GIAN LƯU CACHE (Giây)
CACHE_TTL_PRICE=300         # 5 phút cho giá thời gian thực
CACHE_TTL_FINANCIAL=3600    # 1 giờ cho Báo cáo tài chính
CACHE_TTL_MARKET=60         # 1 phút cho chỉ số thị trường

# 5. ĐƯỜNG DẪN CƠ SỞ DỮ LIỆU & BỘ NHỚ CỤC BỘ (Giữ nguyên mặc định)
DB_PATH=./data/stock_analytics.duckdb
CACHE_DIR=./data/cache
REPORTS_DIR=./reports/output

DOCUMENTS_DIR=./data/documents   # nơi lưu BCTN / BCTC dạng PDF đã tải

# 6. CHIẾN LƯỢC KẾT HỢP NGUỒN DỮ LIỆU (v2)
# Giá N ngày gần nhất lấy từ DNSE (API biểu đồ công khai, không cần tài khoản)
DNSE_RECENT_DAYS=365
# Giá lịch sử (cũ hơn N ngày): thử lần lượt từ trái sang phải
PRICE_HISTORY_SOURCES=vnstock_vci,vnstock_kbs,vnstock_msn,vietstock
# BCTC: nguồn trước được ưu tiên, nguồn sau bù kỳ / chỉ tiêu còn thiếu
FINANCIAL_SOURCES=vnstock_vci,vnstock_kbs,vietstock,pdf
# Nơi dò tài liệu PDF (sau đó luôn thử thêm website doanh nghiệp)
DOCUMENT_SOURCES=vietstock,cafef
CACHE_TTL_NEWS=1800
CACHE_TTL_DOCUMENTS=86400
